# Kaggle credentials (for downloading the MAMI 2022 dataset via kagglehub).
# Use EITHER the classic username + key pair, OR a single API token (KGAT_...).
# The newer token is read by kagglehub as KAGGLE_API_TOKEN.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
KAGGLE_API_TOKEN=your_kaggle_api_token

# Cloud VLM API keys (only needed for Gemini / GPT-4o-mini benchmarks).
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key

# HuggingFace token (for gated model downloads, optional).
HF_TOKEN=your_hf_token

# GitHub token (optional): used by the `gh` CLI / a GitHub MCP server.
# Create a fine-grained PAT at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat
